{
  "name": "adproof-ai-media-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx watch --env-file=.env.local server/src/index.ts",
    "dev:worker": "tsx --env-file=.env.local worker/src/index.ts",
    "build": "tsc -b && vite build --config vite.config.ts && tsc -p server/tsconfig.json",
    "preview": "vite preview --config vite.config.ts",
    "build:release": "node scripts/build-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "start:api:production": "node dist-server/server/src/index.js",
    "start:worker:production": "node dist-worker/index.mjs",
    "test:release": "node --test scripts/test/release.test.mjs",
    "start:api": "node --env-file=.env.local dist-server/server/src/index.js",
    "test:server": "node --import tsx --test server/test/app.test.ts",
    "test:worker": "node --import tsx --test worker/test/*.test.ts",
    "test:eval": "node --import tsx --test eval/test/*.test.ts",
    "test": "npm run test:server && npm run test:worker && npm run test:eval",
    "typecheck": "tsc -b && tsc -p server/tsconfig.test.json && tsc -p tsconfig.worker.json",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:push:dry": "supabase db push --dry-run",
    "db:migrations": "supabase migration list",
    "poc:xhs": "tsx worker/src/poc/xhs-browser-poc.ts",
    "eval:server": "node scripts/start-eval-server.mjs",
    "seed:public-kb:xhs": "tsx --env-file=.env.local server/src/scripts/seed-xiaohongshu-audit-guidelines.ts",
    "lint": "node scripts/lint.mjs",
    "validate": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@supabase/supabase-js": "2.112.3",
    "@types/pg": "^8.23.1",
    "docx": "^9.7.1",
    "fastify": "5.12.0",
    "fastify-plugin": "6.0.0",
    "lucide-react": "1.31.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "xlsx": "^0.18.5",
    "zod": "4.4.3",
    "zstd-codec": "^0.1.5",
    "zstddec": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "supabase": "2.114.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "allowScripts": {
    "zstd-codec@0.1.5": true
  }
}
