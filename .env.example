# Browser-safe values from the Supabase project Connect dialog.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_BASE_URL=/api/v1

# Fastify uses the same publishable key to verify user JWTs and make RLS-bound requests.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Server-side secrets for encrypted XHS session persistence.
# Must be configured TOGETHER (both set or both empty). When both are set, the API
# persists the encrypted Xiaohongshu session to platform_sessions; otherwise it runs
# in-memory and a service restart requires re-scanning.
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard -> Settings -> API Keys -> service_role (new-style).
# XHS_SESSION_ENCRYPTION_KEY: 32-byte key as 64 hex chars (or 44 base64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
# XHS_SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Worker 闁烩晝顥愮换娑㈠极閻楀牆绁﹂幖瀛樻惈缁辨獤rivate schema 濞寸姾顕ф慨鐔兼⒓閻斿嘲鐏欏☉鎾崇У濮ｆ岸妫侀懠顒傝埗 PostgREST闁挎稑顦埀?# Supabase dashboard -> Project Settings -> Database -> Connection string (transaction pooler)闁?# 闁瑰瓨鐗楃€?pooler-url 闁哄秶鍘х槐锟犳晬濮濈湐stgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.replace_me:replace_me@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 濞戞挸鐡ㄥ鍌滀焊韫囨洖顒㈠☉鏃撻檮閺嗙喖骞戦鐣岀埍闁挎稑鐗嗛悾濂稿棘?API 闁汇垹鐤囬顒傗偓鐟版湰閸ㄦ岸宕ユ惔鈥冲弗闁告帒娲ゅú?browser闁挎稑鑻悾濂稿棘绾懐绠鹃柟鎭掑劚濞呮帡宕ｉ敃渚囨斀闂侇偄鍊块崢銈夋晬?
# DataFlow 鐏忓繒瀛╂稊?V3 閸忣剙绱戦弫鐗堝祦濠ф劧绱欓弮鐘绘付閹殿偆鐖滈敍?XHS_DATA_PROVIDER=redfox
REDFOX_API_KEY=replace_me
REDFOX_BASE_URL=https://redfox.hk
REDFOX_SEARCH_PATH=/story/api/xhsUser/searchArticle
REDFOX_NOTE_DETAIL_PATH=/story/api/xhsUser/queryWorkDetail
REDFOX_VIDEO_NOTE_DETAIL_PATH=/story/api/xhsUser/queryWorkDetail
REDFOX_USER_INFO_PATH=/story/api/xhsUser/queryAccountDetail
REDFOX_USER_WORK_LIST_PATH=/story/api/xhsUser/queryWorkList
REDFOX_REQUEST_DELAY_MS=1200
REDFOX_MAX_RETRIES=3
REDFOX_BACKOFF_BASE_MS=1000
REDFOX_TIMEOUT_MS=30000
# Optional task-level wall-clock cap; unset or 0 lets a search run until
# target/source exhaustion/provider limit/cancellation.
# REDFOX_SEARCH_MAX_DURATION_MS=900000
REDFOX_SEARCH_PAGES=3
REDFOX_SEARCH_NOTE_TYPE=不限
REDFOX_SEARCH_SORT_TYPE=_0
REDFOX_SEARCH_EXACT_MATCH=false
OPENAI_API_KEY=replace_me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6-sol

