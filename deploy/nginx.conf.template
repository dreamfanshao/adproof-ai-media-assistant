# Replace app.example.com and certificate paths before nginx -t.
# Place in /etc/nginx/sites-available/adproof (Debian/Ubuntu), not in nginx.conf root.
server {
    listen 80;
    server_name app.example.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://app.example.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name app.example.com;
    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/adproof/current/dist;
    index index.html;
    server_tokens off;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ~ /\. { deny all; }
    location ~* ^/(admin|eval|agent|skills|workspace|data|server|worker|supabase)(/|$) { return 404; }
    location ~* ^/api/(admin|agent|eval)(/|$) { return 404; }
    # Readiness is an internal probe; public health is liveness only.
    location = /api/v1/ready { return 404; }
    location /api/v1/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, never append untrusted client-provided forwarded addresses.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
    location /api/ { return 404; }
    location /assets/ { try_files $uri =404; expires 7d; }
    location = /index.html { expires -1; }
    location / { try_files $uri $uri/ /index.html; }
}
